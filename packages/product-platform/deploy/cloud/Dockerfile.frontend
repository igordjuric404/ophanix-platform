# syntax=docker/dockerfile:1.7

FROM nginx:1.27-alpine AS runtime

COPY packages/product-platform/frontend /usr/share/nginx/html
COPY packages/product-platform/deploy/cloud/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz
