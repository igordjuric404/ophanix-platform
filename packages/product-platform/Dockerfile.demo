# syntax=docker/dockerfile:1.7

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY packages/product-platform/pyproject.toml ./pyproject.toml
COPY packages/product-platform/src ./src

RUN python -m pip install --upgrade pip \
    && python -m pip install -e .

EXPOSE 8088

ENTRYPOINT ["python", "-m", "product_platform.cli"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8088"]
